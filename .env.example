# Good Times App — Environment Variables
# Copy this file to .env and fill in values from the Supabase dashboard.
# DO NOT commit .env to git.
#
# These keys are anon (public) keys. RLS protects the data.
# For service-role / admin scripts, use SUPABASE_SERVICE_ROLE_KEY (never bundled).

# ============================================================
# GT AUTH/USERS DATABASE — czocqfaovfpjweayniuw
# Holds: gt_user_profiles, gt_saved_items, auth flows
# Dashboard: https://supabase.com/dashboard/project/czocqfaovfpjweayniuw
# ============================================================
VITE_GT_SUPABASE_URL=https://czocqfaovfpjweayniuw.supabase.co
VITE_GT_SUPABASE_ANON_KEY=

# ============================================================
# KHG MAIN CONTENT DATABASE — dzlmtvodpyhetvektfuo
# Holds: gt_venues, gt_shows, gt_cities, gt_app_laws, all gt_* content tables
# Dashboard: https://supabase.com/dashboard/project/dzlmtvodpyhetvektfuo
# ============================================================
VITE_KHG_SUPABASE_URL=https://dzlmtvodpyhetvektfuo.supabase.co
VITE_KHG_SUPABASE_ANON_KEY=

# ============================================================
# OPTIONAL: For server-side scripts only (geocoding, batch enrichment)
# Never include in client bundle. These read from credentials table.
# ============================================================
# SUPABASE_SERVICE_ROLE_KEY=
# GOOGLE_GEOCODING_API_KEY=
# PERPLEXITY_API_KEY=
