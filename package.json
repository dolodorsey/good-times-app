{
  "name": "good-times-app",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test && vite build",
    "test": "node --test scripts/*.test.mjs",
    "verify": "npm run build && npm audit --audit-level=high",
    "preview": "vite preview",
    "ios:build": "npm run build && npx cap sync ios && node scripts/strip-native-admin.mjs",
    "ios:open": "npx cap open ios",
    "ios:run": "npx cap run ios",
    "android:build": "npm run build && npx cap sync android && node scripts/strip-native-admin.mjs",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "serve:dist": "node scripts/serve-dist.mjs",
    "test:ui": "node --test scripts/ui-geometry.test.mjs",
    "audit:screens": "node scripts/screen-audit.mjs"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright-core": "^1.62.1",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.10",
    "uuid": "11.1.1"
  }
}